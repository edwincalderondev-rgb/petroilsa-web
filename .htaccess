# =====================================================================
#  petroilsa.com — configuración de Apache para public_html
#
#  Dentro de public_html también viven las carpetas de otros dominios
#  y subdominios de la cuenta, y Apache les aplica este archivo por
#  herencia. Por eso todo lo que sigue se limita a petroilsa.com
#  (y a pruebas.petroilsa.com, que recibe una copia idéntica) y deja
#  pasar intacto cualquier otro host o carpeta con nombre de dominio.
# =====================================================================

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit


# ---------------------------------------------------------------------
#  1. Reescrituras y redirecciones
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
RewriteEngine On

# 1.1  Cualquier otro host sale de aquí sin cambios.
RewriteCond %{HTTP_HOST} !^(www\.)?petroilsa\.com$ [NC]
RewriteCond %{HTTP_HOST} !^pruebas\.petroilsa\.com$ [NC]
RewriteRule ^ - [L]

# 1.2  Carpetas de otros dominios alojadas en public_html, validación
#      de certificados y cgi-bin: tampoco se tocan.
RewriteRule ^[^/]+\.(petroilsa\.com|clubamigosdelaire\.com)(/|$) - [L]
RewriteRule ^(\.well-known|cgi-bin)(/|$) - [L]

# 1.3  Dirección única: https://petroilsa.com (sin www).
RewriteCond %{HTTP_HOST} ^www\.petroilsa\.com$ [NC]
RewriteRule ^ https://petroilsa.com%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 1.4  Nada que empiece por punto, ni archivos de trabajo o registros.
RewriteRule (^|/)\. - [R=404,L]
RewriteRule (^|/)error_log$ - [R=404,L]
RewriteRule \.(md|sh|ps1|bat|yml|yaml|log|sql|bak|zip|tar|gz|ini)$ - [R=404,L]
RewriteRule ^(pruebas|anterior|repositorios)(/|$) - [R=404,L]
RewriteRule ^0x\.txt$ - [R=404,L]

# ---------------------------------------------------------------------
#  2. Direcciones del sitio anterior → su equivalente en este sitio
#     (301 permanente; se descarta la cadena de consulta)
# ---------------------------------------------------------------------

# 2.1  Mapas del sitio
RewriteRule ^(sitemap_index|post-sitemap|page-sitemap|category-sitemap|wp-sitemap[^/]*)\.xml$ /sitemap.xml [R=301,L,QSD]

# 2.2  Enlaces cortos (/?p=123, /?page_id=45…)
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat|attachment_id|s)= [NC]
RewriteRule ^$ / [R=301,L,QSD]

# 2.3  Productos (español e inglés)
RewriteRule ^(en/)?(productos|products)/petroil-50-10-fuel-oil/?$ /fichas-tecnicas/ficha-tecnica-petroil-50-10.html [R=301,L,QSD]
RewriteRule ^(en/)?(productos|products)/petroil-100-fo-4/?$ /fichas-tecnicas/ficha-tecnica-petroil-100-mifos.html [R=301,L,QSD]
RewriteRule ^(en/)?(productos|products)/petroil-250-fuel-oil-4/?$ /fichas-tecnicas/ficha-tecnica-petroil-250.html [R=301,L,QSD]
RewriteRule ^(en/)?(productos|products)/petroil-300-vlsfo/?$ /fichas-tecnicas/ficha-tecnica-petroil-300.html [R=301,L,QSD]
RewriteRule ^(en/)?(productos|products)/petroil-500-marine-mgo-f-o-4/?$ /fichas-tecnicas/ficha-tecnica-petroil-500.html [R=301,L,QSD]
RewriteRule ^(en/)?(productos|products)/petroil-800-hc/?$ /fichas-tecnicas/ficha-tecnica-petroil-800-hc.html [R=301,L,QSD]
RewriteRule ^(en/)?(productos|products)/petroil-800-g-green/?$ /fichas-tecnicas/ficha-tecnica-petroil-800-g.html [R=301,L,QSD]
RewriteRule ^(en/)?(productos|products)/petroil-40-a-max/?$ /fichas-tecnicas/ficha-tecnica-petroil-40-a-max.html [R=301,L,QSD]
RewriteRule ^(en/)?(productos|products)/petroil-90-(gasolina-premium|premium-gasoline)/?$ /fichas-tecnicas/ficha-tecnica-petroil-90.html [R=301,L,QSD]
RewriteRule ^(en/)?(productos|products)/petroil-60-(nafta-virgen|virgin-naphtha)/?$ /fichas-tecnicas/ficha-tecnica-petroil-60.html [R=301,L,QSD]
RewriteRule ^(en/)?(productos|products)(/.*)?$ /productos.html [R=301,L,QSD]

# 2.4  Páginas institucionales
RewriteRule ^(quienes-somos|conocenos|about-us)/?$ /nosotros/quienes-somos.html [R=301,L,QSD]
RewriteRule ^(contacto|contactanos|contact|precios|prices)/?$ /contacto.html [R=301,L,QSD]
RewriteRule ^pqrs/?$ /legal/pqrsf.html [R=301,L,QSD]
RewriteRule ^(politica-de-proteccion-de-datos|politica-de-cookies-y-privacidad|cookie-and-privacy-preferences)/?$ /legal/politica-datos.html [R=301,L,QSD]
RewriteRule ^petroil-english/?$ / [R=301,L,QSD]
RewriteRule ^(servicios|services)/?$ /#servicios [R=301,L,NE,QSD]
RewriteRule ^(innovacion|innovation)/?$ /#innovacion [R=301,L,NE,QSD]

# 2.5  Secciones y categorías de noticias
RewriteRule ^(noticias|category)/responsabilidad-ambiental(/page/[0-9]+)?/?$ /sostenibilidad/responsabilidad-ambiental.html [R=301,L,QSD]
RewriteRule ^(noticias|category)/compromiso-social(/page/[0-9]+)?/?$ /sostenibilidad/compromiso-social.html [R=301,L,QSD]
RewriteRule ^(noticias|news|category/corporativas)(/page/[0-9]+)?/?$ /#noticias [R=301,L,NE,QSD]
RewriteRule ^category/ /#noticias [R=301,L,NE,QSD]

# 2.6  Noticias del sitio anterior → la página que hoy trata ese tema
RewriteRule ^freedom-250-colombia-estados-unidos-petroil/?$ /noticias/petroil-visita-embajada-estados-unidos-santa-marta.html [R=301,L,QSD]

RewriteRule ^(el-ministerio-de-minas-y-energia-autorizo-la-produccion-y-comercializacion-nacional-de-combustibles-a-petroil-s-a|el-ministerio-de-minas-y-energia-autorizo-a-la-refineria-petroil-s-a|visita-de-la-direccion-de-hidrocarburos-del-ministerio-de-minas-y-energia)/?$ /instalaciones/refineria-santa-marta.html [R=301,L,QSD]

RewriteRule ^(certificacion-bajo-la-trinorma-iso-9001-iso-14001-e-iso-45001|nos-unimos-al-simulacro-nacional-de-respuesta-a-emergencias|la-seguridad-es-primordial-para-nosotros-asegurese-de-ver-este-video-hasta-el-final)/?$ /sostenibilidad/sgi.html [R=301,L,QSD]

RewriteRule ^(un-museo-submarino-protege-a-los-corales-en-el-caribe-colombiano|compromiso-verde-de-petroil|nuestra-mision-mejorar-el-aire-que-respiramos|comprometidos-con-la-sostenibilidad-a-traves-de-la-colaboracion-con-la-fundacion-santa-marta-sostenible|comprometidos-con-un-futuro-sostenible-y-menor-impacto-ambiental)/?$ /sostenibilidad/responsabilidad-ambiental.html [R=301,L,QSD]

RewriteRule ^(dia-de-los-ninos-2024|el-valor-de-nuestro-equipo-construyendo-juntos-un-ambiente-laboral-inspirador|celebrando-el-exito-educativo|fortaleciendo-vinculos-y-crecimiento-personal-en-petroil|celebrando-la-contribucion-de-nuestros-colaboradores-en-el-dia-del-trabajo-en-petroil)/?$ /sostenibilidad/compromiso-social.html [R=301,L,QSD]

RewriteRule ^(comunicado-febrero-2024|alianza-con-primax|alianza-con-biomax|alianza-comercial-con-codis|alternative-environmental-technologies-agrega-socio-de-distribucion-para-paises-seleccionados-de-america-latina|normatividad-en-combustibles-liquidos-derivados-del-petroleo)/?$ /nosotros/quienes-somos.html [R=301,L,QSD]

# 2.7  Rutas internas de WordPress: ya no existen (410 Gone)
#      (/index.php solo si el visitante lo pidió: nunca la búsqueda interna de portada)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+index\.php[\s?/]
RewriteRule ^index\.php$ / [R=301,L,QSD]
RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json)(/|$) - [G]
RewriteRule ^(wp-[^/]*|xmlrpc)\.php$ - [G]
RewriteRule ^(readme\.html|license\.txt)$ - [G]
RewriteRule (^|/)(feed|comments/feed|trackback|embed)/?$ - [G]
RewriteRule ^(author|tag)/ - [G]

# ---------------------------------------------------------------------
#  3. Carpetas sin página de inicio: 404 en lugar de un listado.
#     Va al final para no adelantarse a las redirecciones (p. ej.
#     /noticias/ es hoy una carpeta y debe seguir redirigiendo).
# ---------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^(.+)$ - [R=404,L]
</IfModule>


# ---------------------------------------------------------------------
#  4. Páginas de error, cabeceras, caché y compresión
#     Solo para este sitio: no alcanza a otros hosts ni a las carpetas
#     de otros dominios alojadas en public_html.
# ---------------------------------------------------------------------
<If "%{HTTP_HOST} =~ /^(www\.|pruebas\.)?petroilsa\.com$/i && %{REQUEST_URI} !~ m#^/[^/]+\.(petroilsa\.com|clubamigosdelaire\.com)(/|$)#i">

  DirectoryIndex index.html
  ErrorDocument 404 /404.html
  ErrorDocument 410 /404.html
  AddDefaultCharset UTF-8

  <IfModule mime_module>
    AddType image/webp .webp
    AddType video/webm .webm
    AddType video/mp4 .mp4
    AddType font/woff2 .woff2
    AddType application/json .json
    AddType application/xml .xml
  </IfModule>

  <IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
    Header unset X-Powered-By

    # Imágenes, video y documentos: 7 días. Tipografías: 30 días.
    # HTML, CSS, JS y JSON: el navegador siempre pregunta si cambió
    # (responde 304 si no), para que cada publicación se vea al instante.
    <If "%{REQUEST_URI} =~ m#\.(jpe?g|png|webp|gif|svg|ico|mp4|webm|pdf)$#i">
      Header set Cache-Control "public, max-age=604800"
    </If>
    <ElseIf "%{REQUEST_URI} =~ m#\.(woff2?|ttf|otf)$#i">
      Header set Cache-Control "public, max-age=2592000"
    </ElseIf>
    <Else>
      Header set Cache-Control "no-cache"
    </Else>

    <If "%{HTTP_HOST} =~ /^pruebas\./i">
      Header always set X-Robots-Tag "noindex, nofollow"
    </If>
  </IfModule>

  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/json application/javascript text/javascript image/svg+xml
  </IfModule>

</If>
